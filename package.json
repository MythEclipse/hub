{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "hub",
  "version": "0.1.0",
  "description": "Asepharyana Hub — personal portfolio SPA (Hono/oRPC API + Vite SPA)",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "moon run :dev",
    "build": "moon run :build",
    "format": "biome format --write",
    "lint": "biome check",
    "test": "pnpm -r --filter \"./apps/**\" run test",
    "typecheck": "pnpm -r --filter \"./apps/**\" run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@moonrepo/cli": "2.6.1",
    "@types/node": "^24",
    "typescript": "7.0.2"
  },
  "ignoreScripts": [
    "esbuild"
  ],
  "trustedDependencies": [
    "esbuild"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
