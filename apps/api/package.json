{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@hub/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@orpc/server": "1.16.1",
    "hono": "4.13.14",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
